# Copy to .env and fill in real values for any non-local deployment.
# Never commit a real .env file.

# --- Secrets (generate and store these in a secrets manager in production) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_SECRET_KEY=
# Guards the first-run /setup screen. Leave it unset and one is
# generated into data/.setup_token and printed to the startup log.
# APP_SETUP_TOKEN=

# --- Database ---
# Defaults to a local SQLite file under ./data if unset. For anything
# beyond a single small site, use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/reconcile

# NOTE: leave a setting commented out to use its default. A line like
# "DATABASE_URL=" with nothing after it is NOT the same as leaving it
# out -- Compose passes it through as an empty value.

# --- App behavior ---
ORGANIZATION_NAME=Adult Day Program
SESSION_IDLE_TIMEOUT_MINUTES=20
SESSION_ABSOLUTE_TIMEOUT_HOURS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Set to "false" ONLY for local http:// development. Must be "true" (default)
# whenever the app is reachable over a network, since it marks cookies Secure.
COOKIE_SECURE=true
