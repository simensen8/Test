.venv/
__pycache__/
*.pyc
.env
*.db
.pytest_cache/

# Anything holding real or test participant data, encrypted uploads, or
# the encryption/session keys. The glob is deliberately wide: a stray
# data_test/ or data_p1/ from a local run must never reach the repo,
# which is public.
data/
data*/

# Throwaway build scaffolding. The sandbox this was developed in sits
# behind a TLS-inspecting proxy, so testing the production image there
# needs a Dockerfile variant that trusts the proxy's CA bundle. Neither
# file is part of the build, and neither should ever be committed.
Dockerfile.sandboxtest
ca-bundle.crt
